# irp-core connection - IRP_CORE_API_KEY must be a project-scoped API key issued by
# irp-core (same mechanism the Java SDK uses), not a JWT.
IRP_CORE_BASE_URL=http://localhost:8080
IRP_CORE_API_KEY=paste-the-agent-project-api-key-here

# Shared secret irp-core must send on the X-Internal-Token header when it calls
# POST /v1/investigations here after an incident is created.
INTERNAL_TOKEN=dev-only-internal-token-change-me

# Groq (free tier) - get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

MAX_TOOL_ITERATIONS=8
