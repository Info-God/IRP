# Copy this into your n8n host's environment (docker-compose.yml `environment:` block,
# or a .env file next to it if you use `env_file:`). Restart n8n after adding these.

# Groq free-tier API key -- https://console.groq.com/keys (no card required)
GROQ_API_KEY=

# Telegram bot token -- from @BotFather on Telegram (/newbot)
TELEGRAM_BOT_TOKEN=

# Your Telegram chat id -- message your bot once, then visit
# https://api.telegram.org/bot<TOKEN>/getUpdates to read "chat":{"id": ...}
TELEGRAM_CHAT_ID=
